  <library_effects>
    <effect id="CarMetal-effect">
      <profile_COMMON>
        <newparam sid="CarMetal_png-surface">
          <surface type="2D">
            <init_from>CarMetal_png</init_from>
          </surface>
        </newparam>
        <newparam sid="CarMetal_png-sampler">
          <sampler2D>
            <source>CarMetal_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
