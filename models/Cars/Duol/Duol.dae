  <library_effects>
    <effect id="Alpha_Lights-effect">
      <profile_COMMON>
        <newparam sid="Alpha_Lights_png-surface">
          <surface type="2D">
            <init_from>Alpha_Lights_png</init_from>
          </surface>
        </newparam>
        <newparam sid="Alpha_Lights_png-sampler">
          <sampler2D>
            <source>Alpha_Lights_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Alpha_Lights_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
