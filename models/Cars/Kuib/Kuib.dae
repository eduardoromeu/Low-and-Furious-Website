  <library_effects>
    <effect id="BlackColor-effect">
      <profile_COMMON>
        <newparam sid="BlackColor_png-surface">
          <surface type="2D">
            <init_from>BlackColor_png</init_from>
          </surface>
        </newparam>
        <newparam sid="BlackColor_png-sampler">
          <sampler2D>
            <source>BlackColor_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="BlackColor_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <transparent opaque="A_ONE">
              <color sid="alpha">0 0 0 0.1428572</color>
            </transparent>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
