  <library_effects>
    <effect id="CarMetal-effect">
      <profile_COMMON>
        <newparam sid="CarMetal_png-surface">
          <surface type="2D">
            <init_from>CarMetal_png</init_from>
          </surface>
        </newparam>
        <newparam sid="CarMetal_png-sampler">
          <sampler2D>
            <source>CarMetal_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="CarMetal_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">0.8863636</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
