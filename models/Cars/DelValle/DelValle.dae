  <library_effects>
    <effect id="blackplastic-effect">
      <profile_COMMON>
        <newparam sid="blackplastic_png-surface">
          <surface type="2D">
            <init_from>blackplastic_png</init_from>
          </surface>
        </newparam>
        <newparam sid="blackplastic_png-sampler">
          <sampler2D>
            <source>blackplastic_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
